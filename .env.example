# Address of seller-svc, used only by the SvelteKit server.
SELLER_SVC_URL=http://127.0.0.1:8080

# Use the fixtures in src/lib/mock/ instead of contacting seller-svc.
# Defaults to `true` so `npm run dev` runs without starting the Rust service.
# seller-svc serves all of these endpoints; set `false` (and run `cargo run`
# in ../seller-svc) to use it for real.
SELLER_SVC_MOCK=true

# ID token audience when seller-svc is IAM-protected on Cloud Run. Leave empty
# locally. Terraform sets this to the seller-svc URL.
# SELLER_SVC_AUDIENCE=

# Production build (node build) behind a TLS proxy such as Cloud Run: without
# these, SvelteKit assumes its origin is https and rejects every form POST.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
