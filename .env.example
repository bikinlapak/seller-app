# Alamat seller-svc, hanya dipakai di sisi server SvelteKit.
SELLER_SVC_URL=http://127.0.0.1:8080

# Pakai data tiruan dari src/lib/mock/ dan jangan hubungi seller-svc.
# Bawaannya `true` supaya `npm run dev` jalan sendiri tanpa menyalakan Rust.
# seller-svc sudah melayani semua endpoint ini; setel `false` (dan jalankan
# `cargo run` di ../seller-svc) untuk memakainya.
SELLER_SVC_MOCK=true

# Build produksi (node build) di belakang proxy TLS seperti Cloud Run:
# tanpa ini SvelteKit menganggap origin-nya https dan menolak semua POST form.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
